{
  "name": "lorechain",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:direct": "python -m pytest tests/direct -q",
    "test:frontend": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "preflight": "python scripts/preflight.py",
    "verify": "npm run preflight && npm run test:direct && npm run test:frontend && npm run verify:deployment-source && npm run audit:prod && npm run typecheck && npm run lint && npm run build",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:studionet": "node scripts/exercise-studionet.mjs",
    "verify:deployment-source": "node scripts/verify-deployment-source.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "genlayer-js": "1.1.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
